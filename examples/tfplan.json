{
  "format_version": "1.2",
  "terraform_version": "1.9.5",
  "resource_changes": [
    {
      "address": "aws_s3_bucket.assets",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "assets",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "bucket": "acme-assets-prod",
          "tags": { "Name": "acme-assets-prod", "env": "prod" }
        }
      }
    },
    {
      "address": "aws_iam_role.app",
      "mode": "managed",
      "type": "aws_iam_role",
      "name": "app",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": { "name": "acme-app-task", "path": "/service/" }
      }
    },
    {
      "address": "aws_cloudwatch_log_group.app",
      "mode": "managed",
      "type": "aws_cloudwatch_log_group",
      "name": "app",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": { "name": "/acme/app", "retention_in_days": 30 }
      }
    },
    {
      "address": "aws_sqs_queue.jobs",
      "mode": "managed",
      "type": "aws_sqs_queue",
      "name": "jobs",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": { "name": "acme-jobs", "visibility_timeout_seconds": 60 }
      }
    },
    {
      "address": "aws_route53_record.apex",
      "mode": "managed",
      "type": "aws_route53_record",
      "name": "apex",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "zone_id": "Z1D633PJN98FT9",
          "name": "acme.example.com",
          "type": "A",
          "ttl": 300
        }
      }
    },
    {
      "address": "aws_instance.web",
      "mode": "managed",
      "type": "aws_instance",
      "name": "web",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": {
          "instance_type": "t3.small",
          "tags": { "Name": "acme-web", "env": "prod" }
        }
      }
    },
    {
      "address": "aws_dynamodb_table.sessions",
      "mode": "managed",
      "type": "aws_dynamodb_table",
      "name": "sessions",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": { "name": "acme-sessions", "billing_mode": "PAY_PER_REQUEST" }
      }
    }
  ]
}
